# CivicFlow Environment Configuration

# Database: Supabase PostgreSQL Connection Pooler (Transaction Mode, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Database: Direct / Session Mode (Port 5432) for migrations & seeding
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication Secret for secure session signing
JWT_SECRET="your-32-character-secret-key-for-jwt-signing"

# Application Base URL
NEXT_PUBLIC_APP_URL="https://civicflow-ruddy.vercel.app"

# Vercel Blob Token for Media Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional: External LLM API Key (CivicFlow includes local zero-latency heuristic NLP by default)
OPENAI_API_KEY=""
