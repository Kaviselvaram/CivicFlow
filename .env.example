# CivicFlow Environment Configuration

# Database: Local SQLite file for zero-config portability (change to postgresql:// for production)
DATABASE_URL="file:./dev.db"

# Authentication Secret for secure session signing
JWT_SECRET="civicflow-development-secret-key-32chars-min-2026"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: External LLM API Key (CivicFlow includes local zero-latency heuristic NLP by default)
OPENAI_API_KEY=""
