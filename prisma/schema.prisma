datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  role           String          @default("CITIZEN") // "CITIZEN", "AUTHORITY", "ADMIN"
  phone          String?
  avatarUrl      String?
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id])
  issues         Issue[]         @relation("ReportedIssues")
  assignedIssues Issue[]         @relation("AssignedSupervisor")
  historyChanges StatusHistory[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Department {
  id              String      @id @default(cuid())
  name            String      @unique
  slug            String      @unique
  description     String
  contactEmail    String
  slaHoursDefault Int         @default(48)
  crews           FieldCrew[]
  users           User[]
  issues          Issue[]
  createdAt       DateTime    @default(now())
}

model FieldCrew {
  id           String     @id @default(cuid())
  name         String
  leadName     String
  vehicleId    String?
  phone        String?
  active       Boolean    @default(true)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  issues       Issue[]
  createdAt    DateTime   @default(now())
}

model Issue {
  id                 String          @id @default(cuid())
  ticketNumber       String          @unique
  title              String
  description        String
  category           String          // "ROADS", "SANITATION", "WATER", "ELECTRICAL", "INFRASTRUCTURE", "TRAFFIC"
  subcategory        String?
  priority           String          @default("MEDIUM") // "CRITICAL", "HIGH", "MEDIUM", "LOW"
  status             String          @default("REPORTED") // "REPORTED", "IN_REVIEW", "ASSIGNED", "IN_PROGRESS", "RESOLVED", "VERIFIED", "REOPENED"
  
  // Geolocation
  address            String
  latitude           Float
  longitude          Float
  ward               String?
  
  // Visual Evidence
  photoUrl           String
  resolutionPhotoUrl String?
  resolutionNotes    String?
  
  // Relationships
  reporterId         String
  reporter           User            @relation("ReportedIssues", fields: [reporterId], references: [id])
  
  departmentId       String?
  department         Department?     @relation(fields: [departmentId], references: [id])
  
  assigneeId         String?
  assignee           User?           @relation("AssignedSupervisor", fields: [assigneeId], references: [id])
  
  crewId             String?
  crew               FieldCrew?      @relation(fields: [crewId], references: [id])
  
  // Citizen Verification
  citizenRating      Int?
  citizenFeedback    String?
  reopenReason       String?
  
  // Timestamps
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  resolvedAt         DateTime?
  verifiedAt         DateTime?
  reopenedAt         DateTime?
  
  statusHistory      StatusHistory[]
}

model StatusHistory {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  note       String?
  createdAt  DateTime @default(now())
}
